{
  "name": "beeper",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:sqlite": "VITE_SQLITE_BACKUP=true vite build",
    "start:sqlite": "bun run build:sqlite && bun server/index.js",
    "test:sqlite": "bun test server/storage.test.js",
    "start": "vite --host 0.0.0.0",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "preview:worker": "npm run build && wrangler dev",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "events": "^3.3.0",
    "pouchdb-browser": "^9.0.0",
    "qr-creator": "^1.0.0",
    "qr-scanner": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "pouchdb-browser": {
      "uuid": "^11.1.1"
    }
  }
}
